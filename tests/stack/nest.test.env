# camap-ts (api-core) env for the characterisation test stack.
# Mounted as /srv/.env in nest-test and as /srv/camapts.env in neko-test
# (entrypoint.sh builds /srv/www/env.js from it). Test-only values, no secrets.
# Keys: camap-ts/packages/api-core/src/envSchema.ts

# AUTH -- CAMAP_KEY must equal `key` in config.test.xml
CAMAP_KEY=camap-test-key-0123456789
JWT_ACCESS_TOKEN_SECRET=test-access-secret
JWT_ACCESS_TOKEN_EXPIRATION_TIME=900
JWT_REFRESH_TOKEN_SECRET=test-refresh-secret
JWT_REFRESH_TOKEN_EXPIRATION_TIME=2629746

# DB -- schema comes from tests/db/schema.sql, never synchronised at boot
DB_CONNECTION=mysql
DB_HOST=mysql-test
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=camap_test
DB_PORT=3306
DB_SYNCHRONIZE=false
DB_ENTITIES=./dist/**/*.entity.js
DB_LOGGING=false

# MAIL
MAILER_TRANSPORT=smtp
SMTP_HOST=mailpit-test
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_IGNORE_TLS=true
SMTP_AUTH_USER=mail_user
SMTP_AUTH_PASS=mail_pass

MAPBOX_KEY=

# MISC
API_HOSTNAME=0.0.0.0
API_PORT=3010
CAMAP_LOCAL_HOST=http://neko-test:80
CAMAP_HOST=http://localhost:8180
CAMAP_BRIDGE_API=http://nest-test:3010
FRONT_URL=http://localhost:8180
FRONT_GRAPHQL_URL=/graphql
PUBLIC_PATH=/neostatic/
THEME_ID=default

# HX_TRIGGER_CRONS is deliberately absent: crontab.service.ts only checks that
# it is set (CODE-015: "false" counts as true). Tests trigger crons themselves.
